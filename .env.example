# Copy this file to ".env" (never commit .env). Values below are placeholders.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
SERVE_STATIC=true
RATE_LIMIT_PER_MIN=30
# Time zone used for "today" when checking flight dates
TIMEZONE=Asia/Tehran

# Charter724 (only used when APP_MODE=live)
CHARTER724_BASE_URL=https://api724.ir
CHARTER724_USERNAME=
CHARTER724_PASSWORD=
CHARTER724_TIMEOUT_MS=15000
# Set to true ONLY after Charter724 confirms in writing that the account is a safe sandbox
CHARTER724_SANDBOX_CONFIRMED=false
# Must stay false until real, authorized transactions are intended
ALLOW_LIVE_TRANSACTIONS=false
